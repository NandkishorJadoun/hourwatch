{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first6",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "vars": {
    "BETTER_AUTH_URL": "https://first6.2006.workers.dev"
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "BETTER_AUTH_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 5 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "first6-db",
      "database_id": "6f2d008f-8955-420b-ac4a-f5473c7ec7a5"
    }
  ]
}