{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourwatch",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "vars": {
    "BETTER_AUTH_URL": "https://hourwatch.2006.workers.dev",
    "VAPID_PUBLIC_KEY": "BLFzR-MTooko4KsTXzt7tI2ZyqawOt_qPwvOFqzDZW8r8b_ZJksKP0ONQYWtk-RTFF0w3IE-bgFl_UHOqtSjb24",
    "VAPID_SUBJECT": "https://github.com/NandkishorJadoun/first6"
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "BETTER_AUTH_SECRET",
      "VAPID_PRIVATE_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 5 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "first6-db",
      "database_id": "6f2d008f-8955-420b-ac4a-f5473c7ec7a5"
    }
  ]
}